{
  "name": "lummo",
  "productName": "Lummo Studio",
  "private": true,
  "version": "3.0.0-rc.1",
  "description": "Modern Dev Server & Database Control Panel",
  "author": "DaesJuar03",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "version:set": "node ./scripts/sync-version.cjs",
    "version:sync": "node ./scripts/sync-version.cjs --sync",
    "prebuild": "node ./scripts/sync-version.cjs --sync",
    "build": "vite build",
    "build:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./scripts/compile-bytecode.cjs",
    "installer:gif": "electron ./scripts/generate-installer-gif.cjs",
    "dist": "npm run build && npm run build:electron && electron-builder",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "bytenode": "^1.6.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "framer-motion": "^13.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.475.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "pidusage": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "gifenc": "^1.0.3",
    "javascript-obfuscator": "^5.6.0",
    "rollup-plugin-obfuscator": "^1.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.lummo.studio",
    "productName": "Lummo Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "DaesJuar03",
        "repo": "lummo-studio"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/main.core.jsc",
      "electron/preload.cjs",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/Lummo.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lummo Studio",
      "installerIcon": "public/Lummo.ico",
      "uninstallerIcon": "public/Lummo.ico"
    }
  }
}
